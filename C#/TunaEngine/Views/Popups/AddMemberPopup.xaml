<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="TunaEngine.Views.Popups.AddMemberPopup"
    BackgroundColor="Transparent"
    Padding="0">
    <Border
        WidthRequest="320"
        MaximumWidthRequest="460"
        Padding="22"
        BackgroundColor="{StaticResource ThemeSurface}"
        Stroke="{StaticResource ThemeStroke}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 12">
        <VerticalStackLayout Spacing="16">
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Novo membro"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="{StaticResource ThemeText}" />
                <Label
                    Text="Adicione um membro à tabela Tunos."
                    FontSize="14"
                    TextColor="{StaticResource ThemeMuted}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Entry
                    x:Name="NameEntry"
                    Placeholder="Nome do membro"
                    MaxLength="80"
                    TextColor="{StaticResource ThemeText}"
                    PlaceholderColor="{StaticResource ThemeMuted}"
                    BackgroundColor="{StaticResource ThemeSurfaceDark}" />
                <Entry
                    x:Name="RoleEntry"
                    Text="Tuno"
                    Placeholder="Cargo"
                    MaxLength="60"
                    TextColor="{StaticResource ThemeText}"
                    PlaceholderColor="{StaticResource ThemeMuted}"
                    BackgroundColor="{StaticResource ThemeSurfaceDark}" />
                <Label
                    x:Name="ErrorLabel"
                    IsVisible="False"
                    FontSize="13"
                    TextColor="{StaticResource ThemeError}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button
                    Grid.Column="0"
                    Text="Cancelar"
                    Clicked="OnCancelClicked"
                    TextColor="{StaticResource ThemeText}"
                    BackgroundColor="{StaticResource ThemeSurfaceDark}"
                    CornerRadius="10" />
                <Button
                    Grid.Column="1"
                    Text="Adicionar"
                    Clicked="OnSaveClicked"
                    TextColor="White"
                    BackgroundColor="{StaticResource ThemeAccent}"
                    CornerRadius="10" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>